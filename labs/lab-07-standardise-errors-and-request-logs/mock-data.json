{
  "lab": 7,
  "title": "Standardise Errors and Request Logs",
  "scenario": "Northstar Commerce catalog, CRM and ordering system using authorised synthetic classroom data only",
  "frontend_origin": "http://127.0.0.1:8000",
  "resource_contract": {
    "resource": "Product",
    "fields": {
      "id": "integer generated by SQLite",
      "sku": "unique uppercase code, 3-24 characters",
      "name": "string, 3-120 characters",
      "price": "non-negative decimal with two places",
      "stock_quantity": "integer, 0-100000",
      "status": "active | inactive | discontinued"
    }
  },
  "seed_products": [
    {
      "sku": "NS-LAMP-01",
      "name": "Orbit Desk Lamp",
      "price": 89.0,
      "stock_quantity": 18,
      "status": "active"
    },
    {
      "sku": "NS-MUG-02",
      "name": "Field Notes Mug",
      "price": 26.0,
      "stock_quantity": 35,
      "status": "active"
    },
    {
      "sku": "NS-STAND-03",
      "name": "Arc Laptop Stand",
      "price": 72.0,
      "stock_quantity": 11,
      "status": "active"
    }
  ],
  "seed_customers": [
    {
      "name": "Aisha Rahman",
      "email": "aisha@example.com",
      "company": "Marina Studio"
    }
  ],
  "invalid_requests": [
    {
      "sku": "x",
      "name": "No",
      "price": -1,
      "stock_quantity": 2
    },
    {
      "sku": "NS-BAD-02",
      "name": "Negative stock",
      "price": 10.0,
      "stock_quantity": -1
    },
    {
      "sku": "NS-BAD-03",
      "name": "Invalid status",
      "price": 10.0,
      "stock_quantity": 2,
      "status": "blocked"
    }
  ],
  "target_files": [
    "app/main.py",
    "app/errors.py",
    "tests/test_errors.py"
  ],
  "acceptance": "404 and 409 use the same envelope; each response request ID locates one log trace; secrets are absent.",
  "data_policy": "Synthetic data only. No personal data, live credentials or confidential source code."
}